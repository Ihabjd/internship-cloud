{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Employer": {
          "type": "string"
        },
        "Job_Title": {
          "type": "string"
        },
        "Job_Family": {
          "type": "string",
          "enum": [
            "Quant Research / Quant Analyst",
            "Quant Developer",
            "Market Risk / Risk Analytics",
            "Model Validation",
            "Derivatives Pricing / Structuring",
            "Trading / Trading Analytics",
            "Capital Markets Data / Python",
            "Asset Management / Portfolio Analytics",
            "Sales / Investment Solutions",
            "Private Equity / Private Debt",
            "Credit Risk",
            "Actuarial",
            "Other"
          ]
        },
        "Location": {
          "type": "string"
        },
        "Country": {
          "type": "string"
        },
        "Source": {
          "type": "string"
        },
        "Job_URL": {
          "type": "string"
        },
        "Requisition_ID": {
          "type": "string"
        },
        "Publication_Date": {
          "type": "string"
        },
        "First_Discovered_Date": {
          "type": "string"
        },
        "Last_Verified_Date": {
          "type": "string"
        },
        "Application_Deadline": {
          "type": "string"
        },
        "Internship_Start_Date": {
          "type": "string"
        },
        "Internship_End_Date": {
          "type": "string"
        },
        "Duration_Months": {
          "type": "string"
        },
        "Match_Score": {
          "type": "string"
        },
        "Priority": {
          "type": "string",
          "enum": [
            "High priority",
            "Worth applying",
            "Stretch opportunity",
            "Low priority",
            ""
          ]
        },
        "Eligibility_Status": {
          "type": "string",
          "enum": [
            "Eligible",
            "Likely eligible",
            "Unclear",
            "Not eligible"
          ]
        },
        "Core_Requirements_Met": {
          "type": "string",
          "enum": [
            "Yes",
            "Partly",
            "No",
            "Unknown"
          ]
        },
        "Main_Strengths": {
          "type": "string"
        },
        "Essential_Gaps": {
          "type": "string"
        },
        "Preferred_Gaps": {
          "type": "string"
        },
        "Fit_Explanation": {
          "type": "string"
        },
        "Verification_Status": {
          "type": "string",
          "enum": [
            "Verified (official page)",
            "Verified active",
            "Unverified",
            "Expired",
            "Inaccessible",
            "Withdrawn"
          ]
        },
        "Notes": {
          "type": "string"
        },
        "Score_Breakdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "points",
                "evidence"
              ]
            },
            "tech": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "points",
                "evidence"
              ]
            },
            "academic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "points",
                "evidence"
              ]
            },
            "career": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "points",
                "evidence"
              ]
            },
            "duration": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "points",
                "evidence"
              ]
            },
            "location": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "points",
                "evidence"
              ]
            }
          },
          "required": [
            "role",
            "tech",
            "academic",
            "career",
            "duration",
            "location"
          ]
        },
        "Required_Skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Preferred_Skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Next_Action": {
          "type": "string"
        },
        "Recommended_CV_Version": {
          "type": "string"
        }
      },
      "required": [
        "Employer",
        "Job_Title",
        "Job_Family",
        "Location",
        "Country",
        "Source",
        "Job_URL",
        "Requisition_ID",
        "Publication_Date",
        "First_Discovered_Date",
        "Last_Verified_Date",
        "Application_Deadline",
        "Internship_Start_Date",
        "Internship_End_Date",
        "Duration_Months",
        "Match_Score",
        "Priority",
        "Eligibility_Status",
        "Core_Requirements_Met",
        "Main_Strengths",
        "Essential_Gaps",
        "Preferred_Gaps",
        "Fit_Explanation",
        "Verification_Status",
        "Notes",
        "Score_Breakdown",
        "Required_Skills",
        "Preferred_Skills",
        "Responsibilities",
        "Languages",
        "Next_Action",
        "Recommended_CV_Version"
      ]
    },
    "language_of_posting": {
      "type": "string",
      "enum": [
        "FR",
        "EN"
      ]
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "value",
          "quote"
        ]
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "reasoning": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "value",
          "reasoning"
        ]
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Eligible",
            "Likely eligible",
            "Unclear",
            "Not eligible"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "reasons"
      ]
    },
    "is_internship_offer": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "listing",
    "language_of_posting",
    "verified_facts",
    "inferences",
    "eligibility",
    "is_internship_offer",
    "warnings"
  ],
  "title": "offer_extract"
}